APP_NAME=Pishrun Project
NODE_ENV=development


HOST=127.0.0.1
PORT=3000

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@cyberspace.ir
BOOTSTRAP_ADMIN_PASSWORD=Admin@123

DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_AUTOLOADENTITIES=true #for typeorm


JWT_SECRET=secretKey
JWT_EXPIRES_IN=60m



# Data Source APIs
# Dataak
DATAAK_URL=https://app.dataak.com
DATAAK_USERNAME=your_username
DATAAK_PASSWORD=your_password

# 8tag (Hashtag)
HASHTAG_URL=https://d1.8tag.ir
HASHTAG_USERNAME=your_username
HASHTAG_PASSWORD=your_password

# Datami
DATAMI_URL=https://datami.ir
DATAMI_USERNAME=your_username
DATAMI_PASSWORD=your_password

# Mahta
MAHTA_URL=https://app.mahta.co
MAHTA_USERNAME=your_username
MAHTA_PASSWORD=your_password

# Promtic (LLM Gateway)
PROMTIC_BASE_URL=https://papi.cyber.pish.run
PROMTIC_API_KEY=your_promtic_api_key

# File storage (avatars, cached post media)
# Set S3_BUCKET to store files in S3 (AWS, ArvanCloud, MinIO, Hetzner, …);
# leave it empty to keep them on local disk under static/ (lost on redeploy
# unless a volume is mounted).
S3_BUCKET=
S3_REGION=us-east-1
# Endpoint for non-AWS providers, e.g. https://s3.ir-thr-at1.arvanstorage.ir
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and most self-hosted / non-AWS providers
S3_FORCE_PATH_STYLE=false
# Optional folder inside the bucket, e.g. cyber-test
S3_PREFIX=
# Optional: public base URL of the bucket/CDN (objects publicly readable).
# When empty, files are served through the API at /api/files/...
S3_PUBLIC_URL=
